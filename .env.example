# Nordhem Furnishing Store — environment configuration
# Copy to .env and adjust:
#   npm install && npm run db:setup && npm run dev
# db:setup = `drizzle-kit push` + seed (idempotent — safe to re-run).

# ---- Database -------------------------------------------------------------
# PostgreSQL via Drizzle ORM. For a rootless local install run
# `bash docs/setup_pg_z.sh` first (installs a user-space PostgreSQL on :5432
# with role postgres/postgres and database app_db — matches drizzle.config.json).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ---- Site ------------------------------------------------------------------
# Canonical public origin — used for metadata, sitemap.xml and robots.txt.
# Inlined at BUILD time: set it before `npm run build` in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Rate limiting ---------------------------------------------------------
# How many proxies sit in FRONT of this server (for the per-IP rate-limit key).
# Proxies APPEND to x-forwarded-for, so the client IP is N hops from the END.
# UNSET (the default) = direct exposure: x-forwarded-for is IGNORED entirely —
# a client-supplied header is self-declared and untrusted, so such clients share
# the "unknown" bucket. Trust must be OPTED INTO: set 1 for one trusted proxy
# (typical edge/ingress), 2 for two, and so on. Unparsable values fail closed.
# With trust declared, a proxy-set x-real-ip header also keys the bucket; without it,
# every client-supplied IP header (x-forwarded-for AND x-real-ip) is ignored.
# TRUSTED_PROXY_DEPTH=1

# ---- Operator cron (scripts/prune-abandoned-carts.mjs) ---------------------
# Age (days) beyond which abandoned cart rows / favourite rows are pruned by the
# operator cron (dry-run by default; --apply to delete). Default 180 = cookie maxAge.
# MAX_AGE_DAYS=180
